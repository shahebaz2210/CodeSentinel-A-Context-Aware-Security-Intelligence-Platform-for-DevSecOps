# CodeSentinel Backend — Environment Variables
# Copy this file to .env and fill in your actual values

# ── Application ──────────────────────────────────────────────
APP_NAME=CodeSentinel
APP_ENV=development
DEBUG=false
SECRET_KEY=CHANGE_ME_USE_RANDOM_32_CHARS_MINIMUM

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://codesentinel:codesentinel@localhost:5432/codesentinel

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Qdrant Vector DB ──────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=security_knowledge

# ── GitHub OAuth App ──────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_random_string
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback

# ── GitHub App (for Check Runs & PR Comments) ─────────────────
# Create at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ── LLM Provider (Google Gemini — free tier) ─────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000"]
